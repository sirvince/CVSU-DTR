NODE_ENV=development

# Most managed container hosts (Render/Railway/Fly) inject their own PORT
# and expect the app to bind to it — PORT wins over APP_PORT when both are
# set, so you usually don't need to set PORT yourself; the host does it.
APP_PORT=3000
APP_TIMEZONE=Asia/Manila
# Required when NODE_ENV=production (app refuses to start without it) — the
# deployed frontend's origin, e.g. https://your-app.pages.dev. Leave unset
# for local dev; main.ts falls back to a permissive CORS policy in that case.
CORS_ORIGIN=

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=teacher_dtr
DATABASE_USER=root
DATABASE_PASSWORD=
# Only needed against a managed MySQL that requires SSL (e.g. Aiven) — paste
# the provider's CA cert contents here. Leave unset for local docker-compose.
DATABASE_SSL_CA=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DTR_TEMPLATE_PATH=storage/templates/dtr/DTR-FORMAT-MASTER.xlsx
STORAGE_PATH=storage/generated
